# ===================================================================
# Tilsim Test — Namuna Muhit Sozlamalari (.env.example)
# Haqiqiy ma'lumotlarni .env fayliga yozing!
# ===================================================================

# --- 1. ASOSIY SOZLAMALAR ---
PROJECT_NAME="Tilsim Test API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# --- 2. MA'LUMOTLAR BAZASI (DATABASE) ---
# SQLite uchun (hozirgi):
DATABASE_URL="sqlite:///./tilsim.db"

# PostgreSQL uchun (kelajakda serverga qo'yilganda):
# DATABASE_URL="postgresql://postgres:parol@localhost:5432/tilsim_db"

# --- 3. XAVFSIZLIK VA JWT TOKEN ---
# Tasodifiy kalit yaratish: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="sizning-tasodifiy-kuchli-maxfiy-kalitingiz"
ALGORITHM="HS256"
# Tokenning yashash vaqti (daqiqa hisobida): 10080 daqiqa = 7 kun
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- 4. MEDIA VA FAYLLAR ---
# Yuklanadigan rasmlar va fayllar saqlanadigan papka
UPLOAD_DIR="./uploads"

# --- 5. SMS PROVAYDER (ESKIZ.UZ) ---
# SMS orqali tasdiqlash kodi yuborish uchun (kelajakda)
ESKIZ_EMAIL="sizning_emailingiz@example.com"
ESKIZ_PASSWORD="sizning_eskiz_parolingiz"

# --- 6. CORS (FRONTEND ULANISHI UCHUN) ---
# Qaysi frontend manzillariga API'dan foydalanishga ruxsat beriladi
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:5500"
